      ],
      "transformations": [
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "all",
            "filters": [
              {
                "fieldName": "release_type",
                "config": {
                  "id": "equal",
                  "options": {
                    "value": "major"
                  }
                }
              }
            ]
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "PR": true,
              "url": true,
              "provider": true,
              "version": true,
              "release_type": true,
              "author": true,
              "created_at": true,
              "merged_at": true,
              "automated": true,
              "planned_merge_date": true,
              "delay_days": true
            }
          }
        },
        {
          "id": "reduce",
          "options": {
            "mode": "reduceFields",
            "reducers": [
              "median"
            ],
            "includeTimeField": false
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center"
